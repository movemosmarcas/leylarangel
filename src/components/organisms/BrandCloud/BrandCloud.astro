---
import './BrandCloud.css';



export interface Props {
  data?: {
    brands: { name: string; logo: string; customStyle?: string }[];
  };
}

const { data } = Astro.props;

const brands = data?.brands || [];
---

<section class="o-brand-cloud">
  <div class="o-brand-cloud__container">
    <div class="o-brand-cloud__carousel">
      <div class="o-brand-cloud__track">
        {[...brands, ...brands, ...brands, ...brands].map((brand) => (
          <div class="o-brand-cloud__card">
            <img 
              src={brand.logo} 
              alt={brand.name} 
              class="o-brand-cloud__logo" 
              style={brand.customStyle || ''}
            />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
