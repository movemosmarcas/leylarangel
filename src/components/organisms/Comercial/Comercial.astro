---
import './Comercial.css';
import cocaColaLogo from '../../../assets/img/Coca-Cola_logo_white.png';
import mymLogo from '../../../assets/img/mym.png';
import lorealLogo from '../../../assets/img/LOreal-Logo.png';
import coppelLogo from '../../../assets/img/Coppel_2025.svg';
import mercedesLogo from '../../../assets/img/Mercedes-Benz_Logo_2010.svg';
import telcelLogo from '../../../assets/img/telcel2.png';
import evenfloLogo from '../../../assets/img/evenflo-logo.avif';
import mattelLogo from '../../../assets/img/mattel.png';

const currentlyOnAirBrands = [
  { name: "M&M's", logo: mymLogo.src, solidBg: true },
  { name: 'Coca-Cola', logo: cocaColaLogo.src },
  { name: "L'Oréal", logo: lorealLogo.src, solidBg: true },
  { name: 'Coppel', logo: coppelLogo.src, solidBg: true },
  { name: 'Mercedes Benz', logo: mercedesLogo.src },
  { name: 'Telcel', logo: telcelLogo.src, solidBg: true, customStyle: 'transform: scale(1.8);' },
  { name: 'Evenflo', logo: evenfloLogo.src },
  { name: 'Mattel', logo: mattelLogo.src, solidBg: true }
];
---

<section class="o-comercial" id="comercial">
  <div class="o-comercial__container">

    <div class="o-comercial__header">
      <div class="o-comercial__header-image">
        <div class="o-comercial__gif-sequence">
          <img src="/img/logo1.png" alt="Leyla Rangel Animación 1" class="o-comercial__gif-frame frame-1" />
          <img src="/img/logo2.png" alt="Leyla Rangel Animación 2" class="o-comercial__gif-frame frame-2" />
          <img src="/img/logo3.png" alt="Leyla Rangel Animación 3" class="o-comercial__gif-frame frame-3" />
        </div>
      </div>
      <div class="o-comercial__header-text">
        <span class="o-comercial__subtitle">Locución Comercial</span>
        <h2 class="o-comercial__title">La Voz que<br /><em>Mueve Marcas</em></h2>
        <p class="o-comercial__intro">
          Con más de <strong>33 años</strong> conectando marcas con audiencias a través del poder de mi voz, llevo mis interpretaciones desde grandes corporativos hasta campañas globales. Para mí, la locución comercial es el arte de comunicar en segundos lo que una marca representa para siempre.
        </p>
      </div>
    </div>

    <div class="o-comercial__body">
      <!-- Top section: Currently on air + Image Card -->
      <div class="o-comercial__currently-card">
        <div class="o-comercial__currently-image" style="position: relative; display: flex; align-items: center; justify-content: center; background: transparent; overflow: hidden; border-radius: 12px; width: 100%;">
          <div class="o-audio-gallery__panel" data-audio-id="comercial-gallery" style="width: 100%; max-width: 800px; margin: 0 auto;">
            <div class="o-audio-gallery__art-wrapper">
              <div class="o-audio-gallery__art-piece" style="aspect-ratio: 2/1; margin: 0 auto; box-shadow: 0 10px 40px rgba(0,0,0,0.3);">
                <div class="o-audio-gallery__art-inner">
                  <img src="/img/Carita-Demo-COMERCIAL.jpg" alt="COMERCIAL" class="o-audio-gallery__image" style="width: 100%; height: 100%; object-fit: cover; object-position: center;" />
                </div>
              </div>
            </div>

            <div class="o-audio-gallery__player">
              <div class="o-audio-gallery__player-info">
                <span class="o-audio-gallery__demo-cat">Voz Institucional</span>
                <h3 class="o-audio-gallery__demo-title">COMERCIAL</h3>
              </div>

              <div class="o-audio-gallery__controls">
                <audio id="audio-comercial-gallery" src="/audio/Leyla%20Rangel%20Demo%20Comercial.mp3"></audio>
                
                <button class="o-audio-gallery__play-btn" aria-label="Reproducir">
                  <span class="o-audio-gallery__icon-play">▶</span>
                  <span class="o-audio-gallery__icon-pause" style="display: none;">‖</span>
                </button>
                
                <div class="o-audio-gallery__progress-wrap">
                  <div class="o-audio-gallery__progress-bar"></div>
                </div>
                
                <div class="o-audio-gallery__time">
                  <span class="o-audio-gallery__current">0:00</span>
                  <span class="o-audio-gallery__separator">/</span>
                  <span class="o-audio-gallery__duration">0:00</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="o-comercial__currently-content">
          <span class="o-comercial__currently-label">Marcas que llevan mi voz comercial</span>
          <div class="o-comercial__carousel-container">
            <div class="o-comercial__carousel">
              <div class="o-comercial__carousel-track">
                {[...currentlyOnAirBrands, ...currentlyOnAirBrands, ...currentlyOnAirBrands].map((brand) => (
                  <div class="o-comercial__carousel-card">
                    <img 
                      src={brand.logo} 
                      alt={brand.name} 
                      class={`o-comercial__carousel-logo ${brand.solidBg ? 'o-comercial__carousel-logo--solid-bg' : ''}`}
                      style={brand.customStyle || ''} 
                    />
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Removed bottom section -->
    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  function initComercialAnimations() {
    gsap.registerPlugin(ScrollTrigger);

    gsap.fromTo('.o-comercial__header-image',
      { opacity: 0, x: -40, filter: 'blur(10px)' },
      {
        opacity: 1, x: 0, filter: 'blur(0px)', duration: 1.2, ease: 'power3.out',
        scrollTrigger: {
          trigger: '.o-comercial',
          start: 'top 80%',
          toggleActions: 'play none none reverse'
        }
      }
    );

    gsap.fromTo('.o-comercial__header-text > *',
      { opacity: 0, y: 30 },
      {
        opacity: 1, y: 0, duration: 1, stagger: 0.15, ease: 'power3.out',
        scrollTrigger: {
          trigger: '.o-comercial',
          start: 'top 80%',
          toggleActions: 'play none none reverse'
        }
      }
    );

    gsap.fromTo('.o-comercial__brands',
      { opacity: 0, y: 50 },
      {
        opacity: 1, y: 0, duration: 1, stagger: 0.2, ease: 'power3.out',
        scrollTrigger: {
          trigger: '.o-comercial__body',
          start: 'top 85%',
          toggleActions: 'play none none reverse'
        }
      }
    );

    // Card Unroll Reveal
    const cardTl = gsap.timeline({
      scrollTrigger: {
        trigger: '.o-comercial__currently-card',
        start: 'top 85%',
        toggleActions: 'play none none reverse'
      }
    });

    cardTl.fromTo('.o-comercial__currently-card',
      { clipPath: 'inset(0% 100% 0% 0%)' }, // Wipe from left to right
      { clipPath: 'inset(0% 0% 0% 0%)', duration: 1.2, ease: 'power4.inOut' }
    )
    .fromTo('.o-comercial__currently-label',
      { opacity: 0, x: -20 },
      { opacity: 1, x: 0, duration: 0.6, ease: 'power2.out' },
      '-=0.4'
    )
    .fromTo('.o-comercial__current-item',
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, stagger: 0.1, duration: 0.6, ease: 'back.out(1.2)' },
      '-=0.4'
    );

    // Image Parallax Effect (Removed per user request)
    
    // Play Button Overlay Logic
    const playOverlay = document.querySelector('.o-comercial__play-overlay');
    const video = document.querySelector('.o-comercial__currently-video');
    
    if (playOverlay && video) {
      playOverlay.addEventListener('click', () => {
        // Hide overlay and play video
        playOverlay.style.display = 'none';
        video.play();
      });

      // Optionally show overlay if video ends or is paused (though native controls usually handle this well enough, 
      // some prefer to just hide the custom overlay permanently once started).
      video.addEventListener('play', () => {
        playOverlay.style.display = 'none';
      });
      video.addEventListener('pause', () => {
        // We can show it again on pause if desired, but let's keep it simple and just show it initially
        // to not clash with native controls pausing.
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initComercialAnimations);
  } else {
    initComercialAnimations();
  }
  document.addEventListener('astro:page-load', initComercialAnimations);
</script>
