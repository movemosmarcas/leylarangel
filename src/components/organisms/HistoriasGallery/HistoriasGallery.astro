---
import "./HistoriasGallery.css";
import HistoriasCard from "../../molecules/HistoriasCard/HistoriasCard.astro";
import { getWordPressPosts } from "../../../services/posts";

const postHistorias = await getWordPressPosts();
console.log(postHistorias);
---

<main class="o-historias-gallery">
  <div class="o-historias-gallery__container">
    <div class="o-historias-gallery__grid">
      {
        postHistorias.map((post) => {
          const coverImage = post.featured_image || "/img/hero-horizontal.png";
          const authorAvatar = post.avatar || "/img/hero-vertical.png";
          const readTime = post.reading_time ? post.reading_time + " min" : undefined;

          return (
            <HistoriasCard
              slug={post.slug}
              title={post.title}
              excerpt={post.excerpt}
              author={post.author}
              authorAvatar={authorAvatar}
              date={post.date}
              readTime={readTime}
              category={post.category || []}
              coverImage={coverImage}
            />
          );
        })
      }
    </div>
  </div>
</main>
